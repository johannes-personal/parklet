# Postgres 14+ with the btree_gist extension available (it ships with
# postgres-contrib, the official Docker image, Supabase and Neon).
# Used by migrations, the seed and the local API only: the app itself never connects to it.
DATABASE_URL=postgres://parklet:parklet@localhost:5432/parklet

# The app reads and writes its data through Supabase's HTTP API (PostgREST), with the
# service key, from the server. Locally, `npm run db:api` serves DATABASE_URL on port
# 3300; its key is printed by `node scripts/postgrest.mjs --print-key`.
SUPABASE_REST_URL=http://localhost:3300
SUPABASE_SERVICE_ROLE_KEY=
# On Vercel the Supabase integration sets SUPABASE_URL and SUPABASE_SECRET_KEY (or the
# legacy SUPABASE_SERVICE_ROLE_KEY) instead; SUPABASE_REST_URL is then not needed.

# Public URL of the app, used in password reset links and the sitemap.
APP_URL=http://localhost:3000

# Map tiles. OpenStreetMap's tile servers are fine for development only:
# switch to a commercial provider (MapTiler, Stadia, Mapbox) before launch.
# Map style (MapLibre). Defaults to OpenFreeMap's dark style: free, no key, commercial use allowed.
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Address search. Photon (komoot) is free and OSM-based; self-host or swap
# for a commercial geocoder in production.
GEOCODER_URL=https://photon.komoot.io

# Payments: "mock" confirms instantly (development and the demo only: refused in
# production unless NEXT_PUBLIC_DEMO=1), "stripe" uses Stripe Connect (README, Payments).
PAYMENT_PROVIDER=mock
# With PAYMENT_PROVIDER=stripe both are required (a missing one is an error, not a
# fall-back to the mock). The secret key: sk_test_… until launch (Developers → API keys).
# STRIPE_SECRET_KEY=sk_test_...
# The webhook endpoints' signing secrets, comma-separated: the endpoint for your account's
# events and the one for connected accounts' events (account.updated). Locally, the single
# secret `stripe listen` prints.
# STRIPE_WEBHOOK_SECRET=whsec_...,whsec_...
# Tests only (e2e/fake-stripe.mjs): send Stripe API calls elsewhere. Refused with a live key.
# STRIPE_API_BASE=http://localhost:3104
# For `npm run test:live`: an Express test account that has finished onboarding, to also
# create a Checkout Session with a real destination charge.
# STRIPE_TEST_CONNECTED_ACCOUNT=acct_...

# Development mail outbox (JSON lines).
# MAIL_OUTBOX=storage/outbox.jsonl

# Real e-mail through Resend (resend.com). Every mail is also kept in the admin
# outbox (/admin/epost); addresses on test domains (@parklet.test) are never sent.
# MAIL_FROM must be on a domain verified in Resend. Until then Resend only
# accepts "onboarding@resend.dev" as sender, and only to your own Resend address.
# RESEND_API_KEY=re_...
# MAIL_FROM=Parklet <noreply@parklet.se>
# MAIL_REPLY_TO=hej@parklet.se

# Where verification documents are stored: "local" (disk, dev) or "supabase" (a private
# Storage bucket; needs SUPABASE_URL and the service key; used on Vercel).
DOCUMENT_STORAGE=local
# DOCUMENT_BUCKET=documents

# Shows the "this is a demo" banner.
# NEXT_PUBLIC_DEMO=1

# BankID through Idura (OpenID Connect). Without these, development and the
# demo use a mock that verifies instantly. Issuer is your Idura domain, e.g.
# https://parklet.test.idura.broker (test) or your production domain.
# IDURA_ISSUER=
# IDURA_CLIENT_ID=
# IDURA_CLIENT_SECRET=
# Encrypts hosts' personnummer (DAC7). Generate with: openssl rand -base64 32
# Keep it safe: losing it makes the stored personnummer unreadable.
# IDENTITY_ENCRYPTION_KEY=

# Bolagsverket's free company register API ("värdefulla datamängder"): checks
# that an organisation exists, its registered name, legal form and status when
# an association or company account is created. Free; register at Bolagsverket
# for client credentials. BOLAGSVERKET_ENV=test uses their test environment.
# Without credentials the check is skipped (manual review only).
# BOLAGSVERKET_CLIENT_ID=
# BOLAGSVERKET_CLIENT_SECRET=
# BOLAGSVERKET_ENV=test

# Car-registration reminders run along with page views. For punctual reminders
# without traffic, have a scheduler (Supabase pg_cron, a GitHub Actions schedule)
# call GET /api/cron/paminnelser every 10–15 minutes with
# "Authorization: Bearer $CRON_SECRET". The endpoint is off while this is unset.
# CRON_SECRET=
