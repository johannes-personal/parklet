# Postgres 14+ with the btree_gist extension available (it ships with
# postgres-contrib, the official Docker image, Supabase and Neon).
DATABASE_URL=postgres://parklet:parklet@localhost:5432/parklet

# Public URL of the app, used in password reset links and the sitemap.
APP_URL=http://localhost:3000

# Map tiles. OpenStreetMap's tile servers are fine for development only:
# switch to a commercial provider (MapTiler, Stadia, Mapbox) before launch.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Address search. Photon (komoot) is free and OSM-based; self-host or swap
# for a commercial geocoder in production.
GEOCODER_URL=https://photon.komoot.io

# Payments: "mock" confirms instantly. See docs/03-mvp.md for the Stripe plan.
PAYMENT_PROVIDER=mock

# Development mail outbox (JSON lines). Production must configure a real provider.
# MAIL_OUTBOX=storage/outbox.jsonl

# Where verification documents are stored: "local" (disk, dev) or "database"
# (Postgres bytea; used on Vercel, whose filesystem is not persistent).
DOCUMENT_STORAGE=local

# Shows the "this is a demo" banner.
# NEXT_PUBLIC_DEMO=1

# On Vercel the Supabase integration sets POSTGRES_URL (transaction pooler);
# the app uses it when DATABASE_URL is not set.

# BankID through Idura (OpenID Connect). Without these, development and the
# demo use a mock that verifies instantly. Issuer is your Idura domain, e.g.
# https://parklet.test.idura.broker (test) or your production domain.
# IDURA_ISSUER=
# IDURA_CLIENT_ID=
# IDURA_CLIENT_SECRET=
# Encrypts hosts' personnummer (DAC7). Generate with: openssl rand -base64 32
# Keep it safe: losing it makes the stored personnummer unreadable.
# IDENTITY_ENCRYPTION_KEY=

# Bolagsverket's free company register API ("värdefulla datamängder"): checks
# that an organisation exists, its registered name, legal form and status when
# an association or company account is created. Free; register at Bolagsverket
# for client credentials. BOLAGSVERKET_ENV=test uses their test environment.
# Without credentials the check is skipped (manual review only).
# BOLAGSVERKET_CLIENT_ID=
# BOLAGSVERKET_CLIENT_SECRET=
# BOLAGSVERKET_ENV=test

# Car-registration reminders run along with page views. For punctual reminders
# without traffic, have a scheduler (Supabase pg_cron, a GitHub Actions schedule)
# call GET /api/cron/paminnelser every 10–15 minutes with
# "Authorization: Bearer $CRON_SECRET". The endpoint is off while this is unset.
# CRON_SECRET=
